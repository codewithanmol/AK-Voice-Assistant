# AK Assistant - environment template
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# --- LLM backend (optional) ---
# Groq free cloud tier (leave empty to use local Ollama only)
GROQ_API_KEY=

# --- Paths ---
# Where AK stores runtime data (conversations, databases, logs)
AK_DATA_PATH=
# Optional alternate config file path
AK_CONFIG=
# Optional unlock-password file path
AK_PW_FILE=

# --- Email (optional, used by AK mailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=AK Assistant

# --- Debug toggles (optional) ---
AK_CALL_DEBUG=
AK_DEBUG_ENGINE=
AK_DEBUG_VOICE=
AK_DEBUG_AUDIO=
