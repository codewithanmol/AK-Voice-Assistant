<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- neon glow underlay -->
    <item android:top="2dp" android:bottom="-6dp" android:right="-10dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4400E5FF"
                android:endColor="#0000E5FF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- main gradient bubble -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/bubbleUserStart"
                android:endColor="@color/bubbleUserEnd"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>